#!/usr/bin/env python3

import json
import os
from pathlib import Path
import stat
import sys
import time
import uuid


class SessionEventError(Exception):
    pass


def valid_command_id(value: object) -> bool:
    return isinstance(value, str) and bool(value) and value.isascii() and all(
        character.isalnum() or character in "._:-" for character in value
    )


def validated_session_file(variable: str) -> Path:
    configured = os.environ.get(variable)
    log_value = os.environ.get("SOR_SESSION_LOG")
    if not configured or not log_value:
        raise SessionEventError("session paths are not configured")

    try:
        log_path = Path(log_value).resolve(strict=True)
        directory = log_path.parent
        path = Path(configured).resolve(strict=True)
        directory_metadata = directory.stat()
        log_metadata = log_path.stat()
        if (
            directory.name != "sor-sessions"
            or not stat.S_ISDIR(directory_metadata.st_mode)
            or directory_metadata.st_uid != os.getuid()
            or not stat.S_ISREG(log_metadata.st_mode)
            or log_metadata.st_uid != os.getuid()
            or not path.is_relative_to(directory)
        ):
            raise SessionEventError("session path is outside its private directory")
        metadata = path.stat()
    except OSError as error:
        raise SessionEventError("session file is unavailable") from error

    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
        raise SessionEventError("session path is not an owned regular file")
    return path


def is_paused() -> bool:
    configured = os.environ.get("SOR_SESSION_PAUSE_FILE")
    if not configured:
        return False
    try:
        directory = Path(os.environ["SOR_SESSION_LOG"]).resolve(strict=True).parent
        path = Path(configured).resolve(strict=True)
        if not path.is_relative_to(directory):
            return True
        metadata = path.stat()
    except FileNotFoundError:
        return False
    except (KeyError, OSError):
        return True
    return True


def clear_start_file() -> str:
    path = validated_session_file("SOR_SESSION_START_FILE")
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        value = os.read(descriptor, 4096).decode("ascii", errors="ignore").strip()
    finally:
        os.close(descriptor)
    descriptor = os.open(path, os.O_WRONLY | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0))
    os.close(descriptor)
    try:
        state = json.loads(value)
        command_id = state.get("command_id", "")
        if valid_command_id(command_id):
            return command_id
    except (json.JSONDecodeError, AttributeError):
        pass
    return ""


def begin_command() -> str:
    if is_paused():
        clear_start_file()
        return ""
    path = validated_session_file("SOR_SESSION_START_FILE")
    command_id = uuid.uuid4().hex
    payload = json.dumps({"command_id": command_id, "started_at": time.time()}, separators=(",", ":"))
    descriptor = os.open(path, os.O_WRONLY | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0))
    try:
        os.write(descriptor, payload.encode("ascii"))
    finally:
        os.close(descriptor)
    return command_id


def finish_command(exit_code: int, cwd: str, command: str) -> str:
    if is_paused():
        clear_start_file()
        return ""
    events_path = validated_session_file("SOR_SESSION_EVENTS")
    start_path = validated_session_file("SOR_SESSION_START_FILE")
    try:
        state_value = start_path.read_text(encoding="ascii").strip()
    except (OSError, ValueError):
        clear_start_file()
        return ""
    command_id = clear_start_file()
    try:
        state = json.loads(state_value)
        started_at = float(state["started_at"])
        command_id = state["command_id"]
    except (json.JSONDecodeError, KeyError, TypeError):
        try:
            started_at = float(state_value)
        except ValueError:
            return ""
        command_id = uuid.uuid4().hex
    if not valid_command_id(command_id):
        return ""
    finished_at = time.time()
    duration_ms = max(0, round((finished_at - started_at) * 1000))
    record = {
        "type": "command",
        "command": command,
        "exit_code": exit_code,
        "cwd": cwd,
        "started_at": started_at,
        "finished_at": finished_at,
        "duration_ms": duration_ms,
        "command_id": command_id,
    }
    payload = (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
    descriptor = os.open(events_path, os.O_WRONLY | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0))
    try:
        remaining = memoryview(payload)
        while remaining:
            remaining = remaining[os.write(descriptor, remaining) :]
    finally:
        os.close(descriptor)
    return command_id


def main(argv: list[str]) -> int:
    try:
        if len(argv) == 1 and argv[0] == "start":
            command_id = begin_command()
            if command_id:
                print(command_id)
            return 0
        if len(argv) == 3 and argv[0] == "finish":
            exit_code = int(argv[1])
            if not 0 <= exit_code <= 255:
                raise SessionEventError("invalid command status")
            command_id = finish_command(exit_code, argv[2], sys.stdin.read())
            if command_id:
                print(command_id)
            return 0
        if len(argv) == 1 and argv[0] == "cancel":
            command_id = clear_start_file()
            if command_id:
                print(command_id)
            return 0
        print("İstifadə: sor-session-event start | finish EXIT_CODE CWD | cancel", file=sys.stderr)
        return 2
    except (OSError, ValueError, SessionEventError) as error:
        print(f"sor-session-event: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
