#!/usr/bin/env python3

import json
import os
from pathlib import Path
import stat
import sys
import time


class SessionEventError(Exception):
    pass


def validated_session_file(variable: str) -> Path:
    configured = os.environ.get(variable)
    log_value = os.environ.get("SOR_SESSION_LOG")
    if not configured or not log_value:
        raise SessionEventError("session paths are not configured")

    try:
        log_path = Path(log_value).resolve(strict=True)
        directory = log_path.parent
        path = Path(configured).resolve(strict=True)
        directory_metadata = directory.stat()
        log_metadata = log_path.stat()
        if (
            directory.name != "sor-sessions"
            or not stat.S_ISDIR(directory_metadata.st_mode)
            or directory_metadata.st_uid != os.getuid()
            or not stat.S_ISREG(log_metadata.st_mode)
            or log_metadata.st_uid != os.getuid()
            or not path.is_relative_to(directory)
        ):
            raise SessionEventError("session path is outside its private directory")
        metadata = path.stat()
    except OSError as error:
        raise SessionEventError("session file is unavailable") from error

    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
        raise SessionEventError("session path is not an owned regular file")
    return path


def is_paused() -> bool:
    configured = os.environ.get("SOR_SESSION_PAUSE_FILE")
    if not configured:
        return False
    try:
        directory = Path(os.environ["SOR_SESSION_LOG"]).resolve(strict=True).parent
        path = Path(configured).resolve(strict=True)
        if not path.is_relative_to(directory):
            return True
        metadata = path.stat()
    except FileNotFoundError:
        return False
    except (KeyError, OSError):
        return True
    return True


def begin_command() -> None:
    if is_paused():
        clear_start_file()
        return
    path = validated_session_file("SOR_SESSION_START_FILE")
    descriptor = os.open(path, os.O_WRONLY | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0))
    try:
        os.write(descriptor, f"{time.time():.9f}\n".encode("ascii"))
    finally:
        os.close(descriptor)


def clear_start_file() -> None:
    path = validated_session_file("SOR_SESSION_START_FILE")
    descriptor = os.open(path, os.O_WRONLY | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0))
    os.close(descriptor)


def finish_command(exit_code: int, cwd: str, command: str) -> None:
    if is_paused():
        clear_start_file()
        return
    events_path = validated_session_file("SOR_SESSION_EVENTS")
    start_path = validated_session_file("SOR_SESSION_START_FILE")
    try:
        started_at = float(start_path.read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        clear_start_file()
        return
    clear_start_file()
    finished_at = time.time()
    duration_ms = max(0, round((finished_at - started_at) * 1000))
    record = {
        "type": "command",
        "command": command,
        "exit_code": exit_code,
        "cwd": cwd,
        "started_at": started_at,
        "finished_at": finished_at,
        "duration_ms": duration_ms,
    }
    payload = (json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
    descriptor = os.open(events_path, os.O_WRONLY | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0))
    try:
        remaining = memoryview(payload)
        while remaining:
            remaining = remaining[os.write(descriptor, remaining) :]
    finally:
        os.close(descriptor)


def main(argv: list[str]) -> int:
    try:
        if len(argv) == 1 and argv[0] == "start":
            begin_command()
            return 0
        if len(argv) == 3 and argv[0] == "finish":
            exit_code = int(argv[1])
            if not 0 <= exit_code <= 255:
                raise SessionEventError("invalid command status")
            finish_command(exit_code, argv[2], sys.stdin.read())
            return 0
        print("İstifadə: sor-session-event start | finish EXIT_CODE CWD", file=sys.stderr)
        return 2
    except (OSError, ValueError, SessionEventError) as error:
        print(f"sor-session-event: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
